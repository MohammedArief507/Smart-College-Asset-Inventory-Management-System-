# =============================================
# Smart Asset Management System - Backend ENV
# =============================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB - Local (MongoDB Compass)
MONGODB_URI=mongodb+srv://SmartAsset2024:9876@cluster0.vutamre.mongodb.net/smart_asset_db?retryWrites=true&w=majority
# JWT
JWT_SECRET=smartasset_jwt_secret_key_2024_secure
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=smartasset_refresh_secret_key_2024_secure
JWT_REFRESH_EXPIRE=7d

# Client URL
CLIENT_URL=http://localhost:5173

# Cloudinary (dummy for now)
CLOUDINARY_CLOUD_NAME=dummy
CLOUDINARY_API_KEY=dummy
CLOUDINARY_API_SECRET=dummy

# Email (dummy for now)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dummy@gmail.com
SMTP_PASS=dummy
FROM_EMAIL=noreply@smartasset.edu
FROM_NAME=Smart Asset System

# Cookie
